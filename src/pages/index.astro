---
// Página inicial — Natu Espaço Canino
// Estrutura: Header → Hero → Services → Horarios → Exclusivity → Infraestrutura → About → Parceria → Testimonials → Location → FAQ → Footer

import About from "../components/sections/About.astro";
import Exclusivity from "../components/sections/Exclusivity.astro";
import FAQ from "../components/sections/FAQ.astro";
import Footer from "../components/sections/Footer.astro";
import Header from "../components/sections/Header.astro";
import Hero from "../components/sections/Hero.astro";
import Horarios from "../components/sections/Horarios.astro";
import Infraestrutura from "../components/sections/Infraestrutura.astro";
import Location from "../components/sections/Location.astro";
import Parceria from "../components/sections/Parceria.astro";
import Services from "../components/sections/Services.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <Header />

  <main id="main-content" tabindex="-1">
    <Hero />
    <Services />
    <Horarios />
    <Exclusivity />
    <Infraestrutura />
    <About />
    <Parceria />
    <Testimonials />
    <Location />
    <FAQ />
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  // Rastreamento de cliques WhatsApp via dataLayer (GTM)
  document.addEventListener("click", function (e) {
    var el = e.target.closest("[data-tracking]");
    if (!el) return;
    var action = el.getAttribute("data-tracking");
    var section = el.getAttribute("data-section");
    if (action && action.includes("whatsapp")) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: "contato_wpp",
        click_action: action,
        click_section: section || "unknown",
      });
    }
  });
</script>
