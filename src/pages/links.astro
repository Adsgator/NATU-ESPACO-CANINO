---
import { Image } from "astro:assets";
import fotoPerfil from "../assets/images/avatar_links.webp";
import bannerHero from "../assets/images/banner_links.webp";

export const prerender = true;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || "https://natuespacocanino.com.br";
const GTM_ID = import.meta.env.PUBLIC_GTM_ID || "GTM-WNJZBRCD";
const waNumber = import.meta.env.PUBLIC_WA_NUMBER || "5512982668716";
const waMessage =
  import.meta.env.PUBLIC_WA_MESSAGE ||
  "Olá! Gostaria de saber mais sobre a Natu e como funciona a avaliação comportamental para novos alunos.";

const perfil = {
  nome: "Natu Espaço Canino",
  cargo: "Júlia Martins · Piranguçu",
};

const redesSociais = [
  {
    nome: "Instagram",
    href: "https://www.instagram.com/natu_espacocanino/",
    ariaLabel: "Instagram da Natu Espaço Canino",
    tracking: "click-instagram-links",
  },
];

const links = [
  {
    id: "btn-links-site",
    label: "Acessar site",
    href: siteUrl,
    tracking: "click-site-links",
    variant: "primary",
    newTab: false,
    iconSVG:
      '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>',
  },
  {
    id: "btn-links-wa",
    label: "Fale pelo WhatsApp",
    href: `https://wa.me/${waNumber}?text=${encodeURIComponent(waMessage)}`,
    tracking: "click-whatsapp-links",
    variant: "ghost",
    newTab: true,
    iconSVG:
      '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>',
  },
  {
    id: "btn-links-formulario",
    label: "Formulário de avaliação",
    href: "https://form.respondi.app/DCrVwA5V",
    tracking: "click-formulario-avaliacao-links",
    variant: "ghost",
    newTab: true,
    iconSVG:
      '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2zm-8 14H7v-2h4v2zm6-4H7v-2h10v2zm0-4H7V7h10v2z"/></svg>',
  },
];

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />

  <script is:inline define:vars={{ GTM_ID }}>
    (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({"gtm.start":
    new Date().getTime(),event:"gtm.js"});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!="dataLayer"?"&l="+l:"";j.async=true;j.src=
    "https://www.googletagmanager.com/gtm.js?id="+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,"script","dataLayer",GTM_ID);
  </script>

  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, follow" />
  <meta name="theme-color" content="#285224" />
  <title>Natu - Espaço Canino | Links</title>
  <meta
    name="description"
    content="Day care educativo, hospedagem técnica e avaliação comportamental para cães."
  />
  <link rel="canonical" href={`${siteUrl}/links`} />
  <link rel="icon" type="image/png" href="/FAVICON-NATU.png" />

  <meta property="og:title" content="Natu - Espaço Canino | Links" />
  <meta
    property="og:description"
    content="Day care educativo, hospedagem técnica e avaliação comportamental para cães."
  />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={`${siteUrl}/links`} />

  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag("consent", "default", {
      ad_storage: "denied",
      analytics_storage: "denied",
      wait_for_update: 500
    });
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;1,400&family=DM+Sans:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body {
      font-family: "DM Sans", ui-sans-serif, system-ui, sans-serif;
      font-weight: 300;
      background-color: #f0ebe3;
      color: #1d1d1c;
      -webkit-font-smoothing: antialiased;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .links-page {
      min-height: 100vh;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-banner {
      position: relative;
      width: 100%;
      max-width: 430px;
      height: 220px;
      overflow: hidden;
      flex-shrink: 0;
    }

    .hero-banner__img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center 20%;
      display: block;
    }

    .hero-banner__overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(
        to bottom,
        rgba(40, 82, 36, 0.15) 0%,
        rgba(29, 29, 28, 0.35) 100%
      );
    }

    .profile-card {
      width: 100%;
      max-width: 430px;
      background-color: #f7f4f0;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0 20px 48px;
      flex: 1;
    }

    .avatar-wrapper {
      margin-top: -48px;
      z-index: 10;
      position: relative;
    }

    .avatar {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      object-fit: cover;
      object-position: center top;
      border: 4px solid #f7f4f0;
      box-shadow: 0 4px 20px rgba(29, 29, 28, 0.18);
      display: block;
      background-color: #e5dfd6;
    }

    .profile-info {
      margin-top: 14px;
      text-align: center;
      margin-bottom: 8px;
    }

    .profile-name {
      font-family: "Cormorant Garamond", Georgia, serif;
      font-size: 2rem;
      font-weight: 500;
      color: #1d1d1c;
      letter-spacing: 0.01em;
      line-height: 1.1;
      text-wrap: balance;
    }

    .profile-role {
      font-family: "DM Sans", system-ui, sans-serif;
      font-size: 11px;
      font-weight: 600;
      color: #535353;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      margin-top: 5px;
    }

    .social-icons {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 18px;
      margin-top: 20px;
      margin-bottom: 28px;
    }

    .social-icon-link {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 36px;
      height: 36px;
      border: 1px solid #d8d0c5;
      border-radius: 6px;
      color: #535353;
      text-decoration: none;
      transition: border-color 0.18s ease, color 0.18s ease, transform 0.15s ease;
    }

    .social-icon-link:hover {
      border-color: #285224;
      color: #285224;
      transform: translateY(-1px);
    }

    .social-icon-link:active { transform: scale(0.95); }

    .social-icon-link:focus-visible {
      outline: 2px solid #285224;
      outline-offset: 2px;
    }

    .links-list {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .link-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      width: 100%;
      padding: 16px 24px;
      font-family: "DM Sans", system-ui, sans-serif;
      font-size: 15px;
      font-weight: 500;
      letter-spacing: 0.01em;
      text-decoration: none;
      border-radius: 8px;
      border: none;
      transition: background-color 0.18s ease, transform 0.15s ease,
        box-shadow 0.18s ease, border-color 0.18s ease, color 0.18s ease;
      cursor: pointer;
    }

    .link-btn:hover  { transform: translateY(-1px); }
    .link-btn:active { transform: translateY(0); }

    .link-btn:focus-visible {
      outline: 2px solid #285224;
      outline-offset: 2px;
    }

    .link-btn.primary {
      background-color: #285224;
      color: #ffffff;
      box-shadow: 0 2px 14px rgba(40, 82, 36, 0.28);
    }

    .link-btn.primary:hover {
      background-color: #1f421d;
      box-shadow: 0 4px 20px rgba(40, 82, 36, 0.38);
    }

    .link-btn.ghost {
      background-color: #ffffff;
      color: #1d1d1c;
      border: 1px solid #e5dfd6;
      box-shadow: 0 1px 4px rgba(29, 29, 28, 0.07);
    }

    .link-btn.ghost:hover {
      border-color: #285224;
      color: #285224;
      box-shadow: 0 4px 14px rgba(29, 29, 28, 0.10);
    }

    .page-footer {
      margin-top: 40px;
      font-family: "DM Sans", system-ui, sans-serif;
      font-size: 11px;
      color: rgba(29, 29, 28, 0.35);
      text-align: center;
      line-height: 1.6;
    }

    .link-item {
      opacity: 0;
      transform: translateY(20px);
    }

    @keyframes fadeUp {
      to { opacity: 1; transform: translateY(0); }
    }

    @media (prefers-reduced-motion: reduce) {
      .link-item {
        opacity: 1;
        transform: none;
        animation: none !important;
      }
    }
  </style>
</head>
<body>
  <noscript>
    <iframe
      src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
      height="0" width="0"
      style="display:none;visibility:hidden"
    ></iframe>
  </noscript>

  <main class="links-page">
    <div class="hero-banner" role="img" aria-label="Banner da Natu Espaço Canino">
      <Image
        src={bannerHero}
        alt="Natu Espaço Canino"
        class="hero-banner__img"
        width={860}
        height={480}
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero-banner__overlay" aria-hidden="true"></div>
    </div>

    <div class="profile-card">
      <div class="avatar-wrapper link-item" style="animation: fadeUp 0.5s 0s ease both">
        <Image
          src={fotoPerfil}
          alt="Logo da Natu Espaço Canino"
          class="avatar"
          width={200}
          height={200}
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="profile-info link-item" style="animation: fadeUp 0.5s 0.07s ease both">
        <h1 class="profile-name">{perfil.nome}</h1>
        <p class="profile-role">{perfil.cargo}</p>
      </div>

      <nav class="social-icons link-item" style="animation: fadeUp 0.5s 0.14s ease both" aria-label="Redes sociais">
        {redesSociais.map((rede) => (
          <a
            href={rede.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={rede.ariaLabel}
            data-tracking={rede.tracking}
            data-section="links"
            class="social-icon-link"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M7.8,2H16.2C19.4,2 22,4.6 22,7.8V16.2C22,19.4 19.4,22 16.2,22H7.8C4.6,22 2,19.4 2,16.2V7.8C2,4.6 4.6,2 7.8,2M7.6,4A3.6,3.6 0 0,0 4,7.6V16.4A3.6,3.6 0 0,0 7.6,20H16.4A3.6,3.6 0 0,0 20,16.4V7.6A3.6,3.6 0 0,0 16.4,4H7.6M17.2,6A1.2,1.2 0 0,1 18.4,7.2A1.2,1.2 0 0,1 17.2,8.4A1.2,1.2 0 0,1 16,7.2A1.2,1.2 0 0,1 17.2,6M12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9Z"/>
            </svg>
          </a>
        ))}
      </nav>

      <div class="links-list" role="list">
        {links.map((link, i) => (
          <div role="listitem" class="link-item" style={`animation: fadeUp 0.5s ${0.20 + i * 0.08}s ease both`}>
            <a
              href={link.href}
              id={link.id}
              data-tracking={link.tracking}
              data-section="links"
              class={`link-btn ${link.variant}`}
              {...link.newTab ? { target: "_blank", rel: "noopener noreferrer" } : {}}
            >
              <span class="link-btn-icon" aria-hidden="true" set:html={link.iconSVG}></span>
              <span>{link.label}</span>
            </a>
          </div>
        ))}
      </div>

      <footer class="page-footer link-item" style={`animation: fadeUp 0.5s ${0.20 + links.length * 0.08}s ease both`}>
        <p>© {currentYear} Natu - Espaço Canino · Júlia Martins</p>
      </footer>
    </div>
  </main>

  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: "view_links", page_type: "links_page" });

    document.addEventListener("click", function(e) {
      var el = e.target.closest("[data-tracking]");
      if (!el) return;
      var action = el.getAttribute("data-tracking");
      var section = el.getAttribute("data-section");
      window.dataLayer.push({ event: "link_click", click_action: action, click_section: section });
      if (action && action.includes("whatsapp")) {
        window.dataLayer.push({ event: "contato_wpp", click_action: action, click_section: section });
      }
    });
  </script>
</body>
</html>
