---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import finalBg from "../../assets/images/final_bg_2.webp";

const WA_NUMBER = import.meta.env.PUBLIC_WA_NUMBER || "5512982668716";
const WA_MESSAGE =
  import.meta.env.PUBLIC_WA_MESSAGE ||
  "Olá! Gostaria de saber mais sobre a Natu e como funciona a avaliação comportamental para novos alunos.";
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(WA_MESSAGE)}`;

const faqs = [
  {
    question: "Meu cão pode frequentar a Natu?",
    answer:
      "Sim! Os cães são sempre bem-vindos. Nosso objetivo é promover equilíbrio, bem-estar e desenvolvimento emocional, respeitando a individualidade de cada animal. Para isso, cada aluno passa por uma avaliação prévia.",
  },
  {
    question: "Atendem cães reativos?",
    answer:
      "Cães com níveis mais altos de reatividade passam primeiro por avaliação comportamental. Dependendo do caso, podemos indicar manejo individual e acompanhamento direcionado antes da integração à rotina em grupo.",
  },
  {
    question: "Como funciona o descanso dos cães?",
    answer:
      "Todos os cães descansam em caixas ou baias individuais, garantindo segurança, redução de estresse e sono de qualidade. A rotina é acompanhada com atenção para que cada cão descanse com tranquilidade.",
  },
  {
    question: "Aceitam filhotes?",
    answer:
      "Sim! Aceitamos filhotes com o protocolo vacinal completo. O ambiente da Natu é ideal para uma socialização correta desde cedo, respeitando a idade e a fase de desenvolvimento de cada um.",
  },
  {
    question: "Existe separação por porte?",
    answer:
      "Sim. Os cães são separados por porte e também por temperamento. Isso garante interações saudáveis e um melhor aproveitamento da rotina. Na Natu, a qualidade vem sempre antes da quantidade.",
  },
];
---

<div class="relative overflow-hidden">
  <Image
    src={finalBg}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 h-full w-full object-cover object-bottom"
    width={1920}
    height={1080}
  />
  <div class="surface-overlay-dark absolute inset-0"></div>

  <section id="faq" class="relative z-10 pb-12 pt-16 sm:pb-14 sm:pt-20 lg:pb-[4.5rem] lg:pt-24">
    <div class="container-wide max-w-6xl">
      <div class="mb-10 flex flex-col items-center" data-animate>
        <div class="mb-3 flex justify-center">
          <img
            src="/dog-faq.svg"
            alt=""
            aria-hidden="true"
            width="112"
            height="112"
            class="h-24 w-24 object-contain lg:h-[7rem] lg:w-[7rem]"
          />
        </div>
        <span class="label-tag justify-center text-complement before:bg-complement/50 after:bg-complement/50">FAQ</span>
        <h2 class="mt-4 text-center font-serif text-display-lg text-secondary">
          Perguntas frequentes
        </h2>
      </div>

      <div class="section-shell-dark p-4 sm:p-5 lg:p-8" data-animate>
        <div class="space-y-3.5">
          {faqs.map((faq) => (
            <details class="faq-item group premium-panel surface-card-light overflow-hidden">
              <summary class="faq-summary flex cursor-pointer list-none items-center justify-between gap-4 p-4 sm:p-5 lg:px-6">
                <span class="pr-4 font-serif text-h-mini font-bold text-primary">
                  {faq.question}
                </span>
                <span class="faq-icon-shell" aria-hidden="true">
                  <Icon
                    name="lucide:plus"
                    class="faq-icon h-4 w-4 flex-shrink-0 text-secondary"
                  />
                </span>
              </summary>
              <div class="faq-answer" data-faq-content>
                <div class="px-4 pb-4 sm:px-5 sm:pb-5 lg:px-6">
                  <p class="font-sans text-body-base text-text-soft">{faq.answer}</p>
                </div>
              </div>
            </details>
          ))}
        </div>
      </div>

      <div
        id="contato"
        class="premium-panel surface-card-light mx-auto mt-12 max-w-4xl p-6 text-center sm:p-10 lg:p-16"
        data-animate
      >
        <h2 class="mb-3 font-serif text-h-card font-bold text-text-main">
          Vamos construir o equilíbrio do seu cão juntos?
        </h2>
        <p class="mx-auto mb-8 max-w-2xl font-sans text-body-base font-medium text-text-soft">
          Clique no botão abaixo para agendar sua avaliação hoje mesmo.
        </p>
        <a
          href={WA_LINK}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-secondary-gold w-full justify-center sm:w-auto"
          data-tracking="whatsapp-final-cta"
          data-section="final-cta"
        >
          <svg aria-hidden="true" class="h-[25px] w-[25px]" viewBox="0 0 448 512" fill="currentColor">
            <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" />
          </svg>
          Agendar Avaliação
        </a>
      </div>
    </div>
  </section>
</div>

<style>
  .faq-item {
    transition:
      border-color 220ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
  }

  .faq-item[open] {
    border-color: color-mix(in srgb, var(--color-secondary) 24%, var(--color-border));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.76),
      0 18px 42px rgba(24, 37, 24, 0.1);
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon-shell {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--color-secondary) 10%, transparent);
    transition:
      background-color 260ms ease,
      transform 260ms ease;
  }

  .faq-icon {
    transition: transform 320ms cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: center;
  }

  .faq-item[open] .faq-icon-shell {
    background: color-mix(in srgb, var(--color-secondary) 18%, transparent);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }

  .faq-answer {
    height: 0;
    opacity: 0;
    overflow: hidden;
    will-change: height, opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-item,
    .faq-icon-shell,
    .faq-icon,
    .faq-answer {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    var reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var details = Array.prototype.slice.call(document.querySelectorAll("#faq details"));

    function getSummary(detail) {
      return detail.querySelector(".faq-summary");
    }

    function getContent(detail) {
      return detail.querySelector("[data-faq-content]");
    }

    function syncExpandedState(detail, expanded) {
      var summary = getSummary(detail);
      if (summary) {
        summary.setAttribute("aria-expanded", expanded ? "true" : "false");
      }
    }

    function stopAnimation(content) {
      if (content._faqAnimationFrame) {
        cancelAnimationFrame(content._faqAnimationFrame);
        content._faqAnimationFrame = 0;
      }

      content.removeEventListener("transitionend", content._faqTransitionEnd);
      content._faqTransitionEnd = null;
      content.style.transition = "none";
    }

    function animateItem(detail, shouldOpen) {
      var content = getContent(detail);
      if (!content) return;

      stopAnimation(content);

      if (reduceMotion) {
        detail.open = shouldOpen;
        content.style.height = shouldOpen ? "auto" : "0px";
        content.style.opacity = shouldOpen ? "1" : "0";
        content.style.overflow = shouldOpen ? "visible" : "hidden";
        syncExpandedState(detail, shouldOpen);
        return;
      }

      var startHeight = content.offsetHeight;

      if (shouldOpen) {
        detail.open = true;
        syncExpandedState(detail, true);
      }

      var endHeight = shouldOpen ? content.scrollHeight : 0;

      content.style.overflow = "hidden";
      content.style.height = startHeight + "px";
      content.style.opacity = shouldOpen ? "0" : "1";

      content._faqAnimationFrame = requestAnimationFrame(function () {
        content.style.transition =
          "height 340ms cubic-bezier(0.22, 1, 0.36, 1), opacity 220ms ease";
        content.style.height = endHeight + "px";
        content.style.opacity = shouldOpen ? "1" : "0";
      });

      content._faqTransitionEnd = function (event) {
        if (event.propertyName !== "height") return;

        content.removeEventListener("transitionend", content._faqTransitionEnd);
        content._faqTransitionEnd = null;
        content.style.transition = "none";
        content.style.height = shouldOpen ? "auto" : "0px";
        content.style.overflow = shouldOpen ? "visible" : "hidden";

        if (!shouldOpen) {
          detail.open = false;
          syncExpandedState(detail, false);
        }
      };

      content.addEventListener("transitionend", content._faqTransitionEnd);
    }

    details.forEach(function (detail) {
      var content = getContent(detail);
      var summary = getSummary(detail);

      if (!content || !summary || detail.dataset.faqInit === "true") return;

      detail.dataset.faqInit = "true";
      content.style.height = detail.open ? "auto" : "0px";
      content.style.opacity = detail.open ? "1" : "0";
      content.style.overflow = detail.open ? "visible" : "hidden";
      syncExpandedState(detail, detail.open);

      summary.addEventListener("click", function (event) {
        event.preventDefault();

        var willOpen = !detail.open;

        details.forEach(function (other) {
          if (other !== detail && other.open) {
            animateItem(other, false);
          }
        });

        animateItem(detail, willOpen);
      });
    });
  })();
</script>
