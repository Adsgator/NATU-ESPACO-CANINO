---
import { Icon } from "astro-icon/components";

const WA_NUMBER = import.meta.env.PUBLIC_WA_NUMBER || "5512982668716";
const WA_MESSAGE =
  import.meta.env.PUBLIC_WA_MESSAGE ||
  "Olá! Gostaria de saber mais sobre os horários e como funciona a avaliação comportamental para novos alunos.";
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(WA_MESSAGE)}`;

const schedules = [
  {
    title: "Creche Educativa",
    description:
      "A rotina da creche foi planejada para proporcionar equilíbrio, socialização e bem-estar ao longo do dia, respeitando também os momentos de descanso e manejo dos cães.",
    items: [
      { label: "Entrada: 07h às 09h", icon: "lucide:log-in" },
      { label: "Saída: até 18h", icon: "lucide:log-out" },
    ],
    note: "Horários especiais podem ser alinhados previamente conforme a rotina do espaço.",
    panelClass: "premium-panel-dark surface-card-dark",
    titleClass: "text-secondary",
    textColor: "text-white/84",
    iconColor: "text-secondary",
    ctaClass: "btn-secondary-gold",
  },
  {
    title: "Hospedagem Natu",
    description:
      "Para garantir uma estadia tranquila, segura e equilibrada, trabalhamos com horários organizados de check-in e check-out, respeitando a rotina de descanso, alimentação e socialização dos cães hospedados.",
    items: [
      { label: "Check-in: 08h às 10h", icon: "lucide:log-in" },
      { label: "Check-out: até 18h", icon: "lucide:log-out" },
      { label: "Finais de semana e feriados: Check-out até 17h", icon: "lucide:calendar" },
    ],
    note: "Outros horários podem ser alinhados previamente conforme disponibilidade da rotina do espaço.",
    panelClass: "premium-panel surface-card-light",
    titleClass: "text-primary",
    textColor: "text-text-soft",
    iconColor: "text-primary",
    ctaClass: "btn-primary",
  },
];
---

<section id="horarios" class="bg-background section-py pt-0">
  <div class="container-wide">
    <div class="mb-12 text-center" data-animate>
      <span class="label-tag justify-center">Horários</span>
      <h2 class="section-heading mt-4">Rotina estruturada para o bem-estar</h2>
    </div>

    <div class="grid gap-6 md:grid-cols-2 lg:gap-8" data-animate-group>
      {schedules.map((schedule) => (
        <div class:list={[schedule.panelClass, "flex flex-col p-6 sm:p-8 lg:p-10"]} data-animate-item>
          <h3 class:list={[schedule.titleClass, "font-serif text-h-card font-bold"]}>
            {schedule.title}
          </h3>

          <p class:list={[schedule.textColor, "mb-8 mt-4 font-sans text-body-base leading-relaxed"]}>
            {schedule.description}
          </p>

          <div class="mb-8 flex-grow space-y-4">
            {schedule.items.map((item) => (
              <div class="flex items-start gap-3">
                <Icon name={item.icon} class:list={["mt-0.5 h-5 w-5 flex-shrink-0", schedule.iconColor]} />
                <span class:list={[schedule.textColor, "font-sans text-body-base"]}>{item.label}</span>
              </div>
            ))}
          </div>

          <div class="soft-divider mb-6"></div>

          <p class:list={[schedule.textColor, "mb-6 font-sans text-body-sm italic opacity-85"]}>
            {schedule.note}
          </p>

          <a
            href={WA_LINK}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[schedule.ctaClass, "w-full justify-center sm:w-fit"]}
            data-tracking="whatsapp-horarios"
            data-section="horarios"
          >
            <svg aria-hidden="true" class="h-5 w-5 flex-shrink-0" viewBox="0 0 448 512" fill="currentColor">
              <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" />
            </svg>
            Entrar em contato
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
