---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import imgExclusividade01 from "../../assets/images/img_exclusividade_01.webp";
import imgExclusividade02 from "../../assets/images/img_exclusividade_02.webp";
import imgExclusividade03 from "../../assets/images/img_exclusividade_03.webp";
import imgExclusividade04 from "../../assets/images/img_exclusividade_04.webp";

const WA_NUMBER = "5512982668716";
const WA_AVALIACAO_LINK = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent("Olá! Gostaria de agendar uma Avaliação Comportamental para meu cão.")}`;
const WA_ADESTRAMENTO_LINK = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent("Olá, gostaria de saber como funciona o adestramento?")}`;

const idealItems = [
  "Socialização supervisionada",
  "Rotina equilibrada com atividades e descanso",
  "Gasto de energia física e mental",
  "Manejo respeitando o perfil de cada cão",
  "Ambiente seguro, monitorado e organizado",
  "Contato com a natureza e enriquecimento ambiental",
  "Desenvolvimento emocional e comportamental",
  "Hospedagem e creche com rotina estruturada",
];

const carouselImages = [
  { src: imgExclusividade01, alt: "Cão feliz na Natu" },
  { src: imgExclusividade02, alt: "Cão brincando" },
  { src: imgExclusividade03, alt: "Cão descansando" },
  { src: imgExclusividade04, alt: "Atividade canina" },
];
---

<section
  id="exclusividade"
  class="surface-section-dark section-py text-white"
>
  <div class="container-wide">
    <div class="mx-auto mb-16 max-w-3xl text-center" data-animate>
      <span class="label-tag justify-center text-complement before:bg-complement/50">Exclusividade</span>
      <h2 class="mt-4 font-serif text-display-lg text-white">
        O equilíbrio é para todos, mas o nosso formato é exclusivo
      </h2>
      <p class="mx-auto mt-6 max-w-2xl text-body-lg text-white/75">
        Antes de qualquer integração, realizamos uma Avaliação Comportamental
        para entender o momento do seu cão.
      </p>
      <a
        href={WA_AVALIACAO_LINK}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary-gold mt-8 w-full max-w-[22rem] justify-center sm:w-auto sm:max-w-none"
        data-tracking="whatsapp-exclusividade-avaliacao"
        data-section="exclusividade"
      >
        Agendar Avaliação
      </a>
    </div>

    <div class="section-shell-dark mb-10 overflow-hidden sm:mb-12" data-animate-group>
      <div class="grid items-stretch gap-0 lg:grid-cols-2">
        <div class="flex flex-col justify-center p-5 sm:p-8 lg:p-10" data-animate-left>
          <ul class="grid gap-4 sm:grid-cols-2">
            {idealItems.map((item) => (
              <li class="flex items-start gap-3 rounded-[18px] border border-white/8 bg-white/4 px-4 py-4">
                <Icon name="lucide:paw-print" class="mt-0.5 h-5 w-5 flex-shrink-0 text-secondary" />
                <span class="font-sans text-body-base text-white/82">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="relative h-[280px] overflow-hidden rounded-b-[28px] sm:h-[360px] lg:h-[520px] lg:rounded-b-none" data-animate-right>
          <div class="absolute inset-0 overflow-hidden">
            <div class="relative h-full w-full" data-carousel-container>
              <div class="absolute inset-0 flex transition-none" data-carousel-track>
                {[...carouselImages, ...carouselImages, ...carouselImages].map((img) => (
                  <div class="h-full w-full flex-shrink-0">
                    <Image
                      src={img.src}
                      alt={img.alt}
                      class="h-full w-full object-cover"
                      width={600}
                      height={500}
                    />
                  </div>
                ))}
              </div>
            </div>
          </div>
          <div class="surface-overlay-dark pointer-events-none absolute inset-0"></div>
        </div>
      </div>
    </div>

    <div
      class="premium-panel surface-card-light mx-auto max-w-3xl p-6 text-center sm:p-8 lg:p-10"
      data-animate
    >
      <div class="flex flex-col items-center gap-4">
        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-secondary/12 text-secondary">
          <Icon name="lucide:alert-circle" class="h-7 w-7" />
        </div>
        <h3 class="font-serif text-h-cardsm font-bold text-primary">Observação importante</h3>
        <p class="max-w-2xl font-sans text-body-base text-text-soft">
          Para garantir uma convivência segura e equilibrada para todos os cães do grupo,
          cães com dificuldades comportamentais mais intensas, como reatividade,
          agressividade ou ansiedade de separação severa, poderão ser direcionados
          inicialmente para acompanhamento individual e adaptação antes da integração
          na rotina da Natu.
        </p>
        <a
          href={WA_ADESTRAMENTO_LINK}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary mt-2 w-full justify-center sm:w-auto"
          data-tracking="whatsapp-adestramento"
          data-section="exclusividade"
        >
          <svg aria-hidden="true" class="h-5 w-5 flex-shrink-0" viewBox="0 0 448 512" fill="currentColor">
            <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" />
          </svg>
          Adestramento particular
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.querySelector("[data-carousel-track]") as HTMLElement;
  const container = document.querySelector("[data-carousel-container]") as HTMLElement;

  if (track && container) {
    const itemCount = track.children.length / 3;
    const itemWidth = container.offsetWidth;
    let currentIndex = itemCount;
    let autoplayInterval: number;

    const updatePosition = () => {
      track.style.transform = `translateX(${-currentIndex * itemWidth}px)`;
    };

    const moveNext = () => {
      currentIndex++;
      updatePosition();

      if (currentIndex >= itemCount * 2) {
        setTimeout(() => {
          currentIndex = itemCount;
          track.style.transition = "none";
          updatePosition();
          setTimeout(() => {
            track.style.transition = "transform 0.8s ease-in-out";
          }, 50);
        }, 800);
      }
    };

    const startAutoplay = () => {
      autoplayInterval = window.setInterval(moveNext, 4000);
    };

    track.style.transition = "transform 0.8s ease-in-out";
    updatePosition();
    startAutoplay();

    container.addEventListener("mouseenter", () => clearInterval(autoplayInterval));
    container.addEventListener("mouseleave", startAutoplay);
  }
</script>

<style>
  [data-carousel-track] {
    display: flex;
    will-change: transform;
  }
</style>
