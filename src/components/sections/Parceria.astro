---
import { Image } from "astro:assets";
import imgParceriaFormulaNatural from "../../assets/images/img_parceria_formula_natural.webp";
import imgParceriaFormulaNatural01 from "../../assets/images/img_parceria_formula_natural_01.webp";
import imgParceriaFormulaNatural02 from "../../assets/images/img_parceria_formula_natural_02.webp";
import imgParceriaFormulaNatural03 from "../../assets/images/img_parceria_formula_natural_03.webp";
import logoFormulaNatural from "../../assets/images/logo_formula_natural.webp";

const carouselImages = [
  { src: imgParceriaFormulaNatural, alt: "Parceria Formula Natural" },
  { src: imgParceriaFormulaNatural01, alt: "Ração Formula Natural" },
  { src: imgParceriaFormulaNatural02, alt: "Produtos Formula Natural" },
  { src: imgParceriaFormulaNatural03, alt: "Cão feliz com Formula Natural" },
];
---

<section id="parceria" class="bg-background section-py pt-0">
  <div class="container-wide">
    <div class="section-shell" data-animate>
      <div class="mb-10 text-center">
        <span class="label-tag justify-center">Parceria</span>
        <h2 class="section-heading mt-4">Formula Natural</h2>
        <p class="section-copy mx-auto mt-4">
          Acreditamos que a nutrição é parte essencial do bem-estar canino. Por isso,
          contamos com a parceria da Formula Natural, marca de confiança que compartilha nossos
          valores de qualidade e cuidado com os cães.
        </p>
      </div>

      <div class="grid items-center gap-8 lg:grid-cols-[1.05fr_0.95fr]">
        <div class="image-frame relative h-[340px] overflow-hidden rounded-[30px] sm:h-[420px] lg:h-[540px]" data-parceria-carousel>
          <div class="relative h-full w-full">
            {carouselImages.map((img, i) => (
              <div
                class="parceria-slide absolute inset-0"
                data-carousel-slide
                aria-hidden={i !== 0 ? "true" : "false"}
                style={i === 0 ? "opacity:1;z-index:1;" : "opacity:0;z-index:0;"}
              >
                <Image
                  src={img.src}
                  alt={img.alt}
                  class="h-full w-full object-cover"
                  width={500}
                  height={540}
                />
              </div>
            ))}
          </div>
        </div>

        <div class="flex flex-col gap-5">
          <div class="premium-panel p-5 sm:p-6 lg:p-7">
            <h3 class="mb-3 font-serif text-h-card font-bold text-text-dark">
              Nutrição de qualidade
            </h3>
            <p class="font-sans text-body-base text-text-soft">
              Formula Natural oferece rações desenvolvidas com ingredientes premium e
              formulações que respeitam as necessidades nutricionais específicas de cada
              cão. Uma parceria natural para manter a saúde e energia dos nossos alunos.
            </p>
          </div>

          <div class="premium-panel-dark surface-card-dark p-5 sm:p-6 lg:p-7">
            <p class="font-sans text-body-base text-white/82">
              Os cães da Natu recebem alimentação de qualidade, reforçando nosso
              compromisso com o bem-estar integral.
            </p>
          </div>

          <div class="premium-panel flex flex-col items-center gap-4 p-5 text-center sm:flex-row sm:items-center sm:gap-5 sm:text-left">
            <div class="flex h-24 w-24 flex-shrink-0 items-center justify-center">
              <Image
                src={logoFormulaNatural}
                alt="Logo Formula Natural"
                class="h-20 w-20 object-contain"
                width={96}
                height={96}
              />
            </div>
            <p class="font-sans text-sm text-text-soft">
              Marca parceira que compartilha nossos valores de qualidade e cuidado com os cães.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const container = document.querySelector("[data-parceria-carousel]") as HTMLElement;

  if (container) {
    const slides = Array.from(container.querySelectorAll<HTMLElement>("[data-carousel-slide]"));
    const total = slides.length;
    let current = 0;
    let autoplayInterval: number;

    const goTo = (index: number) => {
      const from = slides[current];
      if (from) {
        from.style.opacity = "0";
        from.style.zIndex = "0";
        from.setAttribute("aria-hidden", "true");
      }
      current = (index + total) % total;
      const to = slides[current];
      if (to) {
        to.style.opacity = "1";
        to.style.zIndex = "1";
        to.setAttribute("aria-hidden", "false");
      }
    };

    const next = () => goTo(current + 1);
    const prev = () => goTo(current - 1);

    const startAutoplay = () => {
      autoplayInterval = window.setInterval(next, 4000);
    };

    startAutoplay();
    container.addEventListener("mouseenter", () => clearInterval(autoplayInterval));
    container.addEventListener("mouseleave", startAutoplay);

    let dragStartX = 0;
    let isDragging = false;

    const onDragStart = (x: number) => {
      isDragging = true;
      dragStartX = x;
      clearInterval(autoplayInterval);
      container.style.cursor = "grabbing";
    };

    const onDragEnd = (x: number) => {
      if (!isDragging) return;
      isDragging = false;
      container.style.cursor = "grab";
      const delta = dragStartX - x;
      if (Math.abs(delta) > 40) delta > 0 ? next() : prev();
      startAutoplay();
    };

    container.style.cursor = "grab";
    container.addEventListener("mousedown", (e) => { e.preventDefault(); onDragStart(e.clientX); });
    window.addEventListener("mouseup", (e) => onDragEnd(e.clientX));
    container.addEventListener("touchstart", (e) => { const t = e.touches.item(0); if (t) onDragStart(t.clientX); }, { passive: true });
    container.addEventListener("touchend", (e) => { const t = e.changedTouches.item(0); if (t) onDragEnd(t.clientX); }, { passive: true });
  }
</script>

<style>
  .parceria-slide {
    transition: opacity 0.8s ease;
    will-change: opacity;
  }
</style>
