---
import { Image } from "astro:assets";
import bannerMobile from "../../assets/images/bg_hero_mobile.webp";
import bannerInicial from "../../assets/images/img_hero_correto_natu.webp";

const WA_NUMBER = import.meta.env.PUBLIC_WA_NUMBER || "5512982668716";
const WA_MESSAGE =
  import.meta.env.PUBLIC_WA_MESSAGE ||
  "Olá! Gostaria de saber mais sobre a Natu e como funciona a avaliação comportamental para novos alunos.";
const WA_LINK = `https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(WA_MESSAGE)}`;

const cards = [
  {
    badge: "Segunda a Sexta",
    title: "Creche Educativa",
    text: "A Natu é muito mais do que uma creche. Aqui, seu cão se diverte, socializa e aprende em um ambiente seguro, monitorado e pensado para o bem-estar físico e emocional.\n\nOferecemos socialização supervisionada, treinos de comportamento e atividades de enriquecimento ambiental, sempre respeitando o tempo, a personalidade e as necessidades de cada cão.",
    panelClass: "premium-panel-dark surface-card-dark border-white/10",
    titleColor: "text-complement",
    textColor: "text-white/76",
  },
  {
    badge: "Vagas Limitadas",
    title: "Hospedagem Natu",
    text: "Muito mais do que um lugar para passar a noite. Aqui, seu cão continua com uma rotina equilibrada de atividades, descanso, socialização e cuidados em um ambiente seguro, monitorado e preparado para o bem-estar dele.\n\nA hospedagem é exclusiva para cães já conhecidos pela Natu ou mediante avaliação prévia, garantindo mais segurança e conforto para todos os hóspedes.",
    panelClass: "premium-panel surface-card-light",
    titleColor: "text-primary",
    textColor: "text-text-soft",
  },
];
---

<section id="hero-section" class="relative isolate pb-12 sm:pb-16">
  <div class="relative overflow-hidden">
    <div
      class="relative min-h-[clamp(640px,100svh,940px)] md:min-h-[clamp(720px,92svh,940px)]"
    >
      <Image
        src={bannerMobile}
        alt="Cães correndo no gramado da Natu Espaço Canino"
        class="absolute inset-0 z-0 h-full w-full object-cover object-top md:hidden"
        width={900}
        height={1200}
        loading="eager"
      />
      <Image
        src={bannerInicial}
        alt="Cães correndo no gramado da Natu Espaço Canino"
        class="absolute inset-0 z-0 hidden h-full w-full object-cover object-center md:block"
        width={1920}
        height={960}
        loading="eager"
      />

      <div class="surface-overlay-dark absolute inset-0 z-10"></div>

      <div
        class="container-wide relative z-20 flex min-h-[clamp(640px,100svh,940px)] items-center justify-center px-4 pt-24 text-center sm:px-6 sm:pt-28 md:min-h-[clamp(720px,92svh,940px)] md:pt-32"
      >
        <div
          class="mt-[-32px] w-full max-w-[52rem] sm:mt-[-56px] lg:mt-[-80px]"
          data-animate
        >
          <h1
            class="font-serif text-display-lg font-bold text-white [text-wrap:balance] [font-size:clamp(2.6rem,7vw,3.2rem)]"
          >
            <span class="text-secondary"
              >Natu é muito mais do que uma creche.</span
            >
          </h1>

          <p
            class="mx-auto mt-6 max-w-[36rem] px-2 font-sans text-body-lg text-white/82 sm:mt-7 sm:px-0"
          >
            Aqui, seu cão se diverte, socializa e aprende em um ambiente seguro,
            monitorado e pensado para o bem-estar físico e emocional.
          </p>

          <div class="mt-8 flex justify-center">
            <a
              href={WA_LINK}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-secondary-gold w-full max-w-[22rem] px-6 py-3 sm:w-auto sm:min-w-[220px] sm:max-w-none"
              data-tracking="whatsapp-hero"
              data-section="hero"
            >
              <svg
                aria-hidden="true"
                class="h-[20px] w-[20px] flex-shrink-0"
                viewBox="0 0 448 512"
                fill="currentColor"
              >
                <path
                  d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"
                ></path>
              </svg>
              Agendar Avaliação
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container-wide relative z-20 -mt-10 sm:-mt-16 lg:-mt-24">
    <div class="grid auto-rows-fr gap-5 lg:grid-cols-2">
      {
        cards.map((card, i) => (
          <div
            class:list={[
              card.panelClass,
              "card-hover relative h-full overflow-hidden p-5 sm:p-6 lg:p-8",
            ]}
            data-animate-left={i === 0 ? true : undefined}
            data-animate-right={i === 1 ? true : undefined}
          >
            <div class="panel-top-glow absolute inset-x-0 top-0 h-px" />

            <span
              class:list={[
                "mb-5 inline-flex rounded-full px-4 py-2 font-sans text-pill font-semibold uppercase",
                i === 0
                  ? "bg-complement text-text-main"
                  : "bg-primary/8 text-primary",
              ]}
            >
              {card.badge}
            </span>

            <h2
              class:list={[
                card.titleColor,
                "font-serif text-display-sm font-bold",
              ]}
            >
              {card.title}
            </h2>

            <div class="soft-divider my-5" />

            <p
              class:list={[
                card.textColor,
                "whitespace-pre-line font-sans text-body-base leading-relaxed",
              ]}
            >
              {card.text}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
