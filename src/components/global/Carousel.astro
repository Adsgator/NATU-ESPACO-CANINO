---
// Carousel.astro — wrapper de carrossel baseado em Swiper.
//
// Renderiza a estrutura `.swiper` e inicializa o Swiper no cliente sobre os
// slides passados via <slot>. Cada filho do slot deve ter a classe
// `swiper-slide`. Os <Image> do Astro são renderizados no .astro que usa este
// componente (preservando otimização), então passamos tudo por slot.
//
// As configurações de cada seção vêm por props e são serializadas em
// data-attributes lidos pelo script de inicialização.

interface Props {
  id: string;
  slidesPerView?: number;
  slidesPerViewTablet?: number;
  slidesPerViewMobile?: number;
  spaceBetween?: number;
  loop?: boolean;
  autoplayDelay?: number; // ms; 0 = sem autoplay
  navigation?: boolean;
  class?: string;
}

const {
  id,
  slidesPerView = 1,
  slidesPerViewTablet,
  slidesPerViewMobile,
  spaceBetween = 30,
  loop = true,
  autoplayDelay = 5000,
  navigation = false,
  class: className = "",
} = Astro.props;

const config = {
  slidesPerView,
  slidesPerViewTablet: slidesPerViewTablet ?? slidesPerView,
  slidesPerViewMobile: slidesPerViewMobile ?? slidesPerView,
  spaceBetween,
  loop,
  autoplayDelay,
  navigation,
};
---

<div class="natu-carousel-outer">
<div
  class:list={["natu-carousel swiper", className]}
  data-carousel-id={id}
  data-carousel-config={JSON.stringify(config)}
>
  <div class="swiper-wrapper">
    <slot />
  </div>
  {navigation && (
      <>
        <button
          type="button"
          class="natu-carousel-prev"
          aria-label="Slide anterior"
          data-carousel-prev
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="w-5 h-5">
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </button>
        <button
          type="button"
          class="natu-carousel-next"
          aria-label="Próximo slide"
          data-carousel-next
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" class="w-5 h-5">
            <path d="M9 18l6-6-6-6" />
          </svg>
        </button>
      </>
    )
  }
</div>
</div>

<style>
  .natu-carousel-outer {
    overflow: hidden;
    padding: 0.75rem 1.5rem 3.5rem;
    margin: -0.75rem -1.5rem -3.5rem;
  }

  .natu-carousel {
    width: 100%;
    overflow: visible;
    position: relative;
  }

  .swiper-wrapper {
    display: flex !important;
  }

  .swiper-slide {
    height: auto;
  }
  /* Botões de navegação (estilo discreto, sobre fundo verde) */
  .natu-carousel-prev,
  .natu-carousel-next {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, white 30%, transparent);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, white 18%, transparent),
      color-mix(in srgb, white 8%, transparent)
    );
    backdrop-filter: blur(10px);
    color: var(--color-surface);
    box-shadow: 0 16px 34px color-mix(in srgb, var(--color-dark) 18%, transparent);
    transition:
      background-color 0.3s,
      transform 0.3s,
      border-color 0.3s;
  }
  .natu-carousel-prev:hover,
  .natu-carousel-next:hover {
    background-color: color-mix(in srgb, var(--color-primary) 75%, transparent);
    border-color: color-mix(in srgb, white 55%, transparent);
    transform: translateY(-50%) scale(1.04);
  }
  .natu-carousel-prev {
    left: 12px;
  }
  .natu-carousel-next {
    right: 12px;
  }
</style>

<script>
  import Swiper from "swiper";
  import { Autoplay, Navigation } from "swiper/modules";
  import "swiper/css";

  interface CarouselConfig {
    slidesPerView: number;
    slidesPerViewTablet: number;
    slidesPerViewMobile: number;
    spaceBetween: number;
    loop: boolean;
    autoplayDelay: number;
    navigation: boolean;
  }

  function initCarousels() {
    const carousels = document.querySelectorAll<HTMLElement>(
      ".natu-carousel[data-carousel-config]",
    );

    carousels.forEach((el) => {
      if (el.dataset.carouselInit === "true") return;
      el.dataset.carouselInit = "true";

      const config: CarouselConfig = JSON.parse(
        el.dataset.carouselConfig ?? "{}",
      );

      const prev = el.querySelector<HTMLElement>("[data-carousel-prev]");
      const next = el.querySelector<HTMLElement>("[data-carousel-next]");

      new Swiper(el, {
        modules: [Autoplay, Navigation],
        slidesPerView: config.slidesPerViewMobile,
        spaceBetween: config.spaceBetween,
        loop: config.loop,
        grabCursor: true,
        simulateTouch: true,
        touchRatio: 1,
        autoplay:
          config.autoplayDelay > 0
            ? { delay: config.autoplayDelay, disableOnInteraction: false, pauseOnMouseEnter: true }
            : false,
        navigation:
          config.navigation && prev && next
            ? { prevEl: prev, nextEl: next }
            : false,
        breakpoints: {
          768: { slidesPerView: config.slidesPerViewTablet },
          1024: { slidesPerView: config.slidesPerView },
        },
      });
    });
  }

  initCarousels();
  document.addEventListener("astro:after-swap", initCarousels);
</script>
