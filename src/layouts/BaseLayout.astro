---
// BaseLayout.astro — wrapper de todas as páginas do projeto.
//
// Header e Footer não estão aqui. Vêm da biblioteca Astroteca e são
// compostos na página (index.astro): <BaseLayout> → <Header /> + main + <Footer />.
//
// Inclui: anti-flash dark mode, GTM, Consent Mode v2, SEO/OG, fontes,
// SkipLink, WhatsAppFloat, CookieBanner, ScrollAnimations.

import GTM from "../components/global/GTM.astro";
import SkipLink from "../components/global/SkipLink.astro";
import WhatsAppFloat from "../components/global/WhatsAppFloat.astro";
import CookieBanner from "../components/islands/CookieBanner.tsx";
import ScrollAnimations from "../components/islands/ScrollAnimations.tsx";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  canonical?: string;
  noindex?: boolean;
  schema?: object;
}

const siteUrl = import.meta.env.PUBLIC_SITE_URL || "https://natuespacocanino.com.br";
const seoTitle =
  import.meta.env.PUBLIC_SEO_TITLE ||
  "Natu - Espaço Canino | Adestramento e Hospedagem em Piranguçu-MG";
const seoDescription =
  import.meta.env.PUBLIC_SEO_DESCRIPTION ||
  "A Natu oferece Day Care Educativo e Hospedagem Técnica com foco em equilíbrio e estrutura para cães. Avaliação comportamental e socialização guiada.";
const seoKeywords =
  import.meta.env.PUBLIC_SEO_KEYWORDS ||
  "adestramento canino, creche para cães, hospedagem para cães, day care canino, hotel para cães, socialização canina, Piranguçu, Minas Gerais";

const {
  title = seoTitle,
  description = seoDescription,
  keywords = seoKeywords,
  ogTitle = seoTitle,
  ogDescription = seoDescription,
  canonical = siteUrl,
  noindex = false,
  schema,
} = Astro.props;

const GTM_ID = import.meta.env.PUBLIC_GTM_ID || "GTM-WNJZBRCD";
const DEFAULT_THEME = "light";

const defaultSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Natu - Espaço Canino",
  description:
    "Adestramento e Hospedagem Técnica para cães com foco em equilíbrio, socialização guiada e desenvolvimento emocional.",
  url: siteUrl,
  telephone: "+55-12-98266-8716",
  email: "contato@natuespacocanino.com.br",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Estrada dos Antunes, km 2, Taquaral",
    addressLocality: "Piranguçu",
    addressRegion: "MG",
    postalCode: "37511-000",
    addressCountry: "BR",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: "-22.5276",
    longitude: "-45.3136",
  },
  openingHours: ["Mo-Fr 07:30-17:00"],
  sameAs: ["https://www.instagram.com/natu_espacocanino/"],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5",
    reviewCount: "9",
  },
};

const finalSchema = schema || defaultSchema;
---

<!DOCTYPE html>
<html lang="pt-BR" data-default-theme={DEFAULT_THEME}>
<head>
  <meta charset="UTF-8" />

  <script is:inline>
    (function () {
      var stored = localStorage.getItem("theme");
      var t =
        stored ||
        document.documentElement.dataset.defaultTheme ||
        (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      if (t === "dark") document.documentElement.classList.add("dark");
    })();
  </script>

  {GTM_ID && <GTM id={GTM_ID} />}

  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#285224" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonical} />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={ogDescription} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={`${siteUrl}/og-image.png`} />
  <meta property="og:locale" content="pt_BR" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={ogTitle} />
  <meta name="twitter:description" content={ogDescription} />
  <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />

  <link rel="icon" type="image/png" href="/FAVICON-NATU.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    href="https://fonts.googleapis.com/css2?family=Gliker:wght@400;500;600&display=swap"
    as="style"
    onload="this.onload=null;this.rel='stylesheet'"
  />
  <noscript>
    <link
      href="https://fonts.googleapis.com/css2?family=Gliker:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </noscript>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(finalSchema)} />

  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("consent", "default", {
      ad_storage: "denied",
      analytics_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      wait_for_update: 500,
    });
  </script>
</head>
<body>
  {GTM_ID && (
    <noscript>
      <iframe
        src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0"
        width="0"
        style="display:none;visibility:hidden"
      ></iframe>
    </noscript>
  )}

  <SkipLink />
  <slot />
  <WhatsAppFloat />
  <CookieBanner client:idle />
  <ScrollAnimations client:load />
</body>
</html>
